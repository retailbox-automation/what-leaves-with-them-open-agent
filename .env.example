# Copy to .env only for a live run, then uncomment the live lines. A judge needs none of this: `docker compose up --build` runs SAMPLE_MODE
# (the same agents, SQL and write gate on sample_data/sources/, no model, no credentials). Placeholders only.

# Runtime
SAMPLE_MODE=true
HOST=127.0.0.1
PORT=8000
OA_RUN_TIMEOUT=600

# Graph (FalkorDB). docker-compose.yml sets these for the app container.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Zetaris (live only): the local Zetaris platform bundle with the three sources registered (zetaris_spike/README.md).
# Either the bundle's .env path, or a username and password of that local instance.
# ZETARIS_BUNDLE_ENV=/path/to/zetaris-platform/.env
# ZETARIS_USERNAME=your-zetaris-username
# ZETARIS_PASSWORD=your-zetaris-password
# OA_ZETARIS_TIMEOUT=30

# Model provider (live only): Meterless Nightshift on this machine, the default provider (docs/METERLESS.md).
# Start it with scripts/nightshift_headless.sh start; its token is read from its own state folder, never from here.
# NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# NIGHTSHIFT_SWAP=1
# OA_LLM_MAX_TOKENS=6144
# OA_LLM_TIMEOUT=180
# Development only, another OpenAI-compatible endpoint instead of Nightshift:
# OA_LLM_PROVIDER=ollama
# OA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OA_LLM_MODEL=your-investigator-model-id
# OA_VERIFIER_MODEL=your-verifier-model-id
# OA_LLM_API_KEY=your-api-key-if-any

# Memory engine: auto uses Meterless H-MEM when Node and vendor/hmem/dist are present, else the graph.
HM_MEMORY_BACKEND=auto
