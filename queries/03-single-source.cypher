// 03-single-source: single_source(person='Oskar Alvarez', as_of='2026-09-25')
// What rests only on records written by this person: every source record's author, per item.
// Generated by scripts/export_queries.py from the tool's own trace (seed-42 corpus, FalkorDB 6.0.2); do not edit.
// Each statement starts with FalkorDB's CYPHER parameter header; run them in order.

// [1] [tenant] rows: 1
CYPHER n="Oskar Alvarez" MATCH (n:Person) WHERE n.name = $n RETURN 'Person' AS label, n.name AS name;

// [2] [tenant] rows: 1
CYPHER person="Oskar Alvarez" MATCH (p:Person {name: $person}) RETURN p.notice_at, p.last_day, p.notice_source;

// [3] [tenant] rows: 1
CYPHER t=1790380799 MATCH (:Decision)-[sup:SUPERSEDES]->(d:Decision) WHERE sup.valid_at <= $t RETURN collect(DISTINCT d.id);

// [4] [tenant] rows: 3
CYPHER person="Oskar Alvarez" t=1790380799 replaced=["ADR-0004"] MATCH (me:Person {name: $person})-[mine:DECIDED]->(d:Decision) WHERE mine.valid_at <= $t AND NOT d.id IN $replaced MATCH (x)-[r:DECIDED|CONSTRAINS|SUPERSEDES]-(d) WHERE r.valid_at <= $t UNWIND r.source_ids AS sid MATCH (e:Episode {id: sid}) WHERE e.ts <= $t RETURN d.id, d.title, collect(DISTINCT e.author), collect(DISTINCT e.id) ORDER BY d.id;

// [5] [tenant] rows: 8
CYPHER person="Oskar Alvarez" t=1790380799 ended=[] MATCH (me:Person {name: $person})-[w:OWNS|WORKED_ON|WAS]->(s:System) WHERE w.valid_at <= $t AND (type(w) <> 'WAS' OR (w.predicate = 'OWNS' AND (w.invalid_at > $t OR w.closed_by IN $ended))) WITH s, collect(DISTINCT CASE WHEN type(w) = 'WAS' THEN 'OWNS' ELSE type(w) END) AS rels MATCH (s)-[r:OWNS|WORKED_ON|DEPENDS_ON|CONSTRAINS|WAS]-(x) WHERE r.valid_at <= $t AND (type(r) <> 'WAS' OR r.invalid_at > $t OR r.closed_by IN $ended) UNWIND r.source_ids AS sid MATCH (e:Episode {id: sid}) WHERE e.ts <= $t RETURN s.name, s.kind, rels, collect(DISTINCT e.author), collect(DISTINCT e.id) ORDER BY s.name;

// [6] [tenant] rows: 11
CYPHER ids=["ADR-0014", "ADR-0015", "DOC-14", "TCK-0121", "TCK-0123", "TCK-0125", "msg-0224", "RB-10", "TCK-0126", "msg-0222", "msg-0223"] UNWIND $ids AS i MATCH (e:Episode {id: i}) RETURN e.id, e.title, e.ts, e.channel, e.author;
