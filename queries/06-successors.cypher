// 06-successors: successors(person='Oskar Alvarez')
// Who could take over: people who worked on the same systems, as candidates.
// Generated by scripts/export_queries.py from the tool's own trace (seed-42 corpus, FalkorDB 6.0.2); do not edit.
// Each statement starts with FalkorDB's CYPHER parameter header; run them in order.

// [1] [tenant] rows: 1
CYPHER n="Oskar Alvarez" MATCH (n:Person) WHERE n.name = $n RETURN 'Person' AS label, n.name AS name;

// [2] [tenant] rows: 1
CYPHER person="Oskar Alvarez" MATCH (p:Person {name: $person}) RETURN p.notice_at, p.last_day, p.notice_source;

// [3] [tenant] rows: 3
CYPHER person="Oskar Alvarez" MATCH (g:GateDecision) WHERE g.outcome = 'CLOSE' AND g.subject = $person OPTIONAL MATCH (g)-[:CITES]->(e:Episode) RETURN g.id, g.ts, g.predicate, g.object, collect(e.id) ORDER BY g.ts, g.id;

// [4] [tenant] rows: 3
CYPHER person="Oskar Alvarez" t=1099511627776 ended=["GD-00224-d1a2d3fca5", "GD-00225-e5a583243b", "GD-00226-d9bd44e96f"] MATCH (me:Person {name: $person})-[r:OWNS|LEADS|MEMBER_OF]->(x) WHERE r.valid_at <= $t RETURN type(r) AS rel, labels(x)[0] AS label, coalesce(x.name, x.id) AS item, r.valid_at AS since, null AS until, r.source_ids AS src, null AS closed_by UNION MATCH (me:Person {name: $person})-[h:WAS]->(x) WHERE h.predicate IN ['OWNS', 'LEADS', 'MEMBER_OF'] AND h.valid_at <= $t AND (h.invalid_at > $t OR h.closed_by IN $ended) RETURN h.predicate AS rel, labels(x)[0] AS label, coalesce(x.name, x.id) AS item, h.valid_at AS since, h.invalid_at AS until, h.source_ids AS src, h.closed_by AS closed_by;

// [5] [tenant] rows: 1
CYPHER t=1099511627776 MATCH (:Decision)-[sup:SUPERSEDES]->(d:Decision) WHERE sup.valid_at <= $t RETURN collect(DISTINCT d.id);

// [6] [tenant] rows: 3
CYPHER person="Oskar Alvarez" t=1099511627776 replaced=["ADR-0004"] MATCH (me:Person {name: $person})-[mine:DECIDED]->(d:Decision) WHERE mine.valid_at <= $t AND NOT d.id IN $replaced MATCH (x)-[r:DECIDED|CONSTRAINS|SUPERSEDES]-(d) WHERE r.valid_at <= $t UNWIND r.source_ids AS sid MATCH (e:Episode {id: sid}) WHERE e.ts <= $t RETURN d.id, d.title, collect(DISTINCT e.author), collect(DISTINCT e.id) ORDER BY d.id;

// [7] [tenant] rows: 9
CYPHER person="Oskar Alvarez" t=1099511627776 ended=["GD-00224-d1a2d3fca5", "GD-00225-e5a583243b", "GD-00226-d9bd44e96f"] MATCH (me:Person {name: $person})-[w:OWNS|WORKED_ON|WAS]->(s:System) WHERE w.valid_at <= $t AND (type(w) <> 'WAS' OR (w.predicate = 'OWNS' AND (w.invalid_at > $t OR w.closed_by IN $ended))) WITH s, collect(DISTINCT CASE WHEN type(w) = 'WAS' THEN 'OWNS' ELSE type(w) END) AS rels MATCH (s)-[r:OWNS|WORKED_ON|DEPENDS_ON|CONSTRAINS|WAS]-(x) WHERE r.valid_at <= $t AND (type(r) <> 'WAS' OR r.invalid_at > $t OR r.closed_by IN $ended) UNWIND r.source_ids AS sid MATCH (e:Episode {id: sid}) WHERE e.ts <= $t RETURN s.name, s.kind, rels, collect(DISTINCT e.author), collect(DISTINCT e.id) ORDER BY s.name;

// [8] [tenant] rows: 2
CYPHER items=["fernhill-sso", "oncall-runbook"] UNWIND $items AS item MATCH (x:System {name: item}) OPTIONAL MATCH (x)-[:DEPENDS_ON]->(down:System) OPTIONAL MATCH (up:System)-[:DEPENDS_ON]->(x) RETURN item, collect(DISTINCT down.name), collect(DISTINCT up.name);

// [9] [tenant] rows: 0
CYPHER items=[] UNWIND $items AS item MATCH (:Decision {id: item})-[:CONSTRAINS]->(s:System) RETURN item, collect(s.name);

// [10] [tenant] rows: 4
CYPHER systems=["auth", "fernhill-sso", "oncall-runbook"] person="Oskar Alvarez" UNWIND $systems AS sys MATCH (c:Person)-[w:WORKED_ON]->(:System {name: sys}) WHERE c.name <> $person OPTIONAL MATCH (c)-[:MEMBER_OF]->(t:Team) RETURN sys, c.name, t.name, coalesce(w.count, size(w.source_ids)), w.source_ids;

// [11] [tenant] rows: 10
CYPHER ids=["DOC-14", "TCK-0007", "msg-0021", "TCK-0015", "TCK-0020", "TCK-0026", "TCK-0031", "TCK-0022", "msg-0048", "RB-10"] UNWIND $ids AS i MATCH (e:Episode {id: i}) RETURN e.id, e.title, e.ts, e.channel, e.author;
