// 07-promises: promises(person='Oskar Alvarez')
// A question the graph cannot answer: searched records, and an honest not_in_graph.
// Generated by scripts/export_queries.py from the tool's own trace (seed-42 corpus, FalkorDB 6.0.2); do not edit.
// Each statement starts with FalkorDB's CYPHER parameter header; run them in order.

// [1] [tenant] rows: 1
CYPHER n="Oskar Alvarez" MATCH (n:Person) WHERE n.name = $n RETURN 'Person' AS label, n.name AS name;

// [2] [tenant] rows: 1
CYPHER person="Oskar Alvarez" MATCH (p:Person {name: $person}) RETURN p.notice_at, p.last_day, p.notice_source;

// [3] [tenant] rows: 3
CYPHER person="Oskar Alvarez" MATCH (g:GateDecision) WHERE g.outcome = 'CLOSE' AND g.subject = $person OPTIONAL MATCH (g)-[:CITES]->(e:Episode) RETURN g.id, g.ts, g.predicate, g.object, collect(e.id) ORDER BY g.ts, g.id;

// [4] [tenant] rows: 11
CYPHER person="Oskar Alvarez" since=1790330400 MATCH (e:Episode) WHERE e.ts > $since AND e.author = $person RETURN e.id AS id, e.ts AS ts, e.channel AS channel, e.author AS author, e.title AS title, e.text AS text UNION MATCH (e:Episode)-[:MENTIONS]->(:Person {name: $person}) WHERE e.ts > $since RETURN e.id AS id, e.ts AS ts, e.channel AS channel, e.author AS author, e.title AS title, e.text AS text;

// [5] [tenant] rows: 1
CYPHER ids=["DOC-15"] UNWIND $ids AS i MATCH (e:Episode {id: i}) RETURN e.id, e.title, e.ts, e.channel, e.author;
