// 04-without: without(person='Oskar Alvarez')
// The company without them: a projection into a scratch graph, then algo.WCC finds what nobody is connected to.
// Generated by scripts/export_queries.py from the tool's own trace (seed-42 corpus, FalkorDB 6.0.2); do not edit.
// Each statement starts with FalkorDB's CYPHER parameter header; run them in order.
// Statements marked [scratch] run on a temporary graph the tool creates and deletes (GRAPH.QUERY <tenant>__scratch ...); the others on the tenant's graph.

// [1] [tenant] rows: 1
CYPHER n="Oskar Alvarez" MATCH (n:Person) WHERE n.name = $n RETURN 'Person' AS label, n.name AS name;

// [2] [tenant] rows: 1
CYPHER person="Oskar Alvarez" MATCH (p:Person {name: $person}) RETURN p.notice_at, p.last_day, p.notice_source;

// [3] [tenant] rows: 3
CYPHER person="Oskar Alvarez" MATCH (g:GateDecision) WHERE g.outcome = 'CLOSE' AND g.subject = $person OPTIONAL MATCH (g)-[:CITES]->(e:Episode) RETURN g.id, g.ts, g.predicate, g.object, collect(e.id) ORDER BY g.ts, g.id;

// [4] [tenant] rows: 45
MATCH (n:Person) RETURN 'Person' AS label, n.name AS key UNION ALL MATCH (n:Team) RETURN 'Team' AS label, n.name AS key UNION ALL MATCH (n:System) RETURN 'System' AS label, n.name AS key UNION ALL MATCH (n:Decision) RETURN 'Decision' AS label, n.id AS key;

// [5] [tenant] rows: 93
MATCH (p:Person)-[r:OWNS|WORKED_ON|MEMBER_OF|LEADS|DECIDED]->(x) RETURN 'Person' AS a_label, p.name AS a, labels(x)[0] AS b_label, coalesce(x.name, x.id) AS b, type(r) AS rel UNION ALL MATCH (d:Decision)-[r:CONSTRAINS]->(s:System) RETURN 'Decision' AS a_label, d.id AS a, 'System' AS b_label, s.name AS b, type(r) AS rel;

// [6] [tenant] rows: 15
CYPHER person="Oskar Alvarez" ended=["GD-00224-d1a2d3fca5", "GD-00225-e5a583243b", "GD-00226-d9bd44e96f"] MATCH (me:Person {name: $person})-[r:OWNS|WORKED_ON|MEMBER_OF|LEADS|DECIDED]->(x) RETURN type(r) AS rel, labels(x)[0] AS label, coalesce(x.name, x.id) AS item, r.source_ids AS src, coalesce(r.count, 0) AS n, 'current' AS state UNION ALL MATCH (me:Person {name: $person})-[h:WAS]->(x) WHERE h.closed_by IN $ended RETURN h.predicate AS rel, labels(x)[0] AS label, coalesce(x.name, x.id) AS item, h.source_ids AS src, 0 AS n, 'ended' AS state;

// [7] [scratch] rows: 0
CYPHER keys=["Aiko Rademacher", "Lars Thorne", "Luca Ostrander", "Mateo Sandoval", "Omar Fenwick", "Pavel Hollis", "Priya Farrow", "Sana Petrov", "Selma Marsh", "Tomas Kessler", "Viktor Hartwell", "Yuki Moreau", "Zara Lowell"] UNWIND $keys AS k CREATE (:Person {key: k});

// [8] [scratch] rows: 0
CYPHER keys=["Growth", "Payments", "Platform", "Support"] UNWIND $keys AS k CREATE (:Team {key: k});

// [9] [scratch] rows: 0
CYPHER keys=["admin-console", "auth", "billing-api", "fernhill-sso", "invoice-renderer", "ledger-db", "notifications", "oncall-runbook", "reporting", "status-page", "webhooks"] UNWIND $keys AS k CREATE (:System {key: k});

// [10] [scratch] rows: 0
CYPHER keys=["ADR-0001", "ADR-0002", "ADR-0003", "ADR-0004", "ADR-0005", "ADR-0006", "ADR-0007", "ADR-0008", "ADR-0009", "ADR-0010", "ADR-0011", "ADR-0012", "ADR-0013", "ADR-0014", "ADR-0015", "ADR-0016"] UNWIND $keys AS k CREATE (:Decision {key: k});

// [11] [scratch] rows: 0
CYPHER pairs=[["ADR-0001", "Mateo Sandoval"], ["ADR-0002", "Mateo Sandoval"], ["ADR-0003", "Luca Ostrander"], ["ADR-0004", "Mateo Sandoval"], ["ADR-0005", "Selma Marsh"], ["ADR-0006", "Priya Farrow"], ["ADR-0007", "Selma Marsh"], ["ADR-0008", "Aiko Rademacher"], ["ADR-0009", "Selma Marsh"], ["ADR-0010", "Luca Ostrander"], ["ADR-0011", "Viktor Hartwell"], ["ADR-0012", "Viktor Hartwell"], ["ADR-0013", "Yuki Moreau"], ["ADR-0016", "Pavel Hollis"]] UNWIND $pairs AS e MATCH (a:Decision {key: e[0]}), (b:Person {key: e[1]}) CREATE (a)-[:LINK]->(b);

// [12] [scratch] rows: 0
CYPHER pairs=[["ADR-0014", "ledger-db"], ["ADR-0015", "reporting"], ["ADR-0016", "auth"]] UNWIND $pairs AS e MATCH (a:Decision {key: e[0]}), (b:System {key: e[1]}) CREATE (a)-[:LINK]->(b);

// [13] [scratch] rows: 0
CYPHER pairs=[["Aiko Rademacher", "notifications"], ["Aiko Rademacher", "reporting"], ["Lars Thorne", "auth"], ["Lars Thorne", "billing-api"], ["Lars Thorne", "invoice-renderer"], ["Lars Thorne", "webhooks"], ["Luca Ostrander", "admin-console"], ["Luca Ostrander", "auth"], ["Luca Ostrander", "billing-api"], ["Luca Ostrander", "ledger-db"], ["Luca Ostrander", "status-page"], ["Luca Ostrander", "webhooks"], ["Mateo Sandoval", "invoice-renderer"], ["Mateo Sandoval", "ledger-db"], ["Omar Fenwick", "notifications"], ["Omar Fenwick", "reporting"], ["Pavel Hollis", "auth"], ["Pavel Hollis", "ledger-db"], ["Pavel Hollis", "notifications"], ["Pavel Hollis", "webhooks"], ["Priya Farrow", "admin-console"], ["Priya Farrow", "status-page"], ["Sana Petrov", "auth"], ["Sana Petrov", "invoice-renderer"], ["Sana Petrov", "ledger-db"], ["Selma Marsh", "admin-console"], ["Selma Marsh", "billing-api"], ["Selma Marsh", "notifications"], ["Selma Marsh", "status-page"], ["Tomas Kessler", "admin-console"], ["Tomas Kessler", "status-page"], ["Viktor Hartwell", "invoice-renderer"], ["Viktor Hartwell", "ledger-db"], ["Viktor Hartwell", "reporting"], ["Viktor Hartwell", "webhooks"], ["Yuki Moreau", "reporting"]] UNWIND $pairs AS e MATCH (a:Person {key: e[0]}), (b:System {key: e[1]}) CREATE (a)-[:LINK]->(b);

// [14] [scratch] rows: 0
CYPHER pairs=[["Aiko Rademacher", "Growth"], ["Lars Thorne", "Payments"], ["Luca Ostrander", "Platform"], ["Mateo Sandoval", "Payments"], ["Omar Fenwick", "Growth"], ["Pavel Hollis", "Platform"], ["Priya Farrow", "Support"], ["Sana Petrov", "Payments"], ["Selma Marsh", "Platform"], ["Tomas Kessler", "Support"], ["Viktor Hartwell", "Payments"], ["Yuki Moreau", "Growth"], ["Zara Lowell", "Support"]] UNWIND $pairs AS e MATCH (a:Person {key: e[0]}), (b:Team {key: e[1]}) CREATE (a)-[:LINK]->(b);

// [15] [scratch] rows: 44
CALL algo.WCC({nodeLabels: ['Person', 'Team', 'System', 'Decision'], relationshipTypes: ['LINK']}) YIELD node, componentId RETURN labels(node)[0], node.key, componentId;

// [16] [tenant] rows: 9
CYPHER ids=["DOC-14", "TCK-0121", "TCK-0123", "msg-0224", "TCK-0125", "RB-10", "msg-0222", "msg-0223", "TCK-0126"] UNWIND $ids AS i MATCH (e:Episode {id: i}) RETURN e.id, e.title, e.ts, e.channel, e.author;
