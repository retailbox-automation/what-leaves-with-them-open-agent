// 05-bridges: bridges(top=3)
// Who links teams: algo.betweenness on a projection with edges both ways.
// Generated by scripts/export_queries.py from the tool's own trace (seed-42 corpus, FalkorDB 6.0.2); do not edit.
// Each statement starts with FalkorDB's CYPHER parameter header; run them in order.
// Statements marked [scratch] run on a temporary graph the tool creates and deletes (GRAPH.QUERY <tenant>__scratch ...); the others on the tenant's graph.

// [1] [tenant] rows: 45
MATCH (n:Person) RETURN 'Person' AS label, n.name AS key UNION ALL MATCH (n:Team) RETURN 'Team' AS label, n.name AS key UNION ALL MATCH (n:System) RETURN 'System' AS label, n.name AS key UNION ALL MATCH (n:Decision) RETURN 'Decision' AS label, n.id AS key;

// [2] [tenant] rows: 93
MATCH (p:Person)-[r:OWNS|WORKED_ON|MEMBER_OF|LEADS|DECIDED]->(x) RETURN 'Person' AS a_label, p.name AS a, labels(x)[0] AS b_label, coalesce(x.name, x.id) AS b, type(r) AS rel UNION ALL MATCH (d:Decision)-[r:CONSTRAINS]->(s:System) RETURN 'Decision' AS a_label, d.id AS a, 'System' AS b_label, s.name AS b, type(r) AS rel;

// [3] [scratch] rows: 0
CYPHER keys=["Aiko Rademacher", "Lars Thorne", "Luca Ostrander", "Mateo Sandoval", "Omar Fenwick", "Oskar Alvarez", "Pavel Hollis", "Priya Farrow", "Sana Petrov", "Selma Marsh", "Tomas Kessler", "Viktor Hartwell", "Yuki Moreau", "Zara Lowell"] UNWIND $keys AS k CREATE (:Person {key: k});

// [4] [scratch] rows: 0
CYPHER keys=["Growth", "Payments", "Platform", "Support"] UNWIND $keys AS k CREATE (:Team {key: k});

// [5] [scratch] rows: 0
CYPHER keys=["admin-console", "auth", "billing-api", "fernhill-sso", "invoice-renderer", "ledger-db", "notifications", "oncall-runbook", "reporting", "status-page", "webhooks"] UNWIND $keys AS k CREATE (:System {key: k});

// [6] [scratch] rows: 0
CYPHER pairs=[["Aiko Rademacher", "notifications"], ["Aiko Rademacher", "reporting"], ["Lars Thorne", "auth"], ["Lars Thorne", "billing-api"], ["Lars Thorne", "invoice-renderer"], ["Lars Thorne", "webhooks"], ["Luca Ostrander", "admin-console"], ["Luca Ostrander", "auth"], ["Luca Ostrander", "billing-api"], ["Luca Ostrander", "ledger-db"], ["Luca Ostrander", "status-page"], ["Luca Ostrander", "webhooks"], ["Mateo Sandoval", "invoice-renderer"], ["Mateo Sandoval", "ledger-db"], ["Omar Fenwick", "notifications"], ["Omar Fenwick", "reporting"], ["Oskar Alvarez", "admin-console"], ["Oskar Alvarez", "billing-api"], ["Oskar Alvarez", "fernhill-sso"], ["Oskar Alvarez", "ledger-db"], ["Oskar Alvarez", "notifications"], ["Oskar Alvarez", "oncall-runbook"], ["Oskar Alvarez", "reporting"], ["Oskar Alvarez", "status-page"], ["Oskar Alvarez", "webhooks"], ["Pavel Hollis", "auth"], ["Pavel Hollis", "ledger-db"], ["Pavel Hollis", "notifications"], ["Pavel Hollis", "webhooks"], ["Priya Farrow", "admin-console"], ["Priya Farrow", "status-page"], ["Sana Petrov", "auth"], ["Sana Petrov", "invoice-renderer"], ["Sana Petrov", "ledger-db"], ["Selma Marsh", "admin-console"], ["Selma Marsh", "billing-api"], ["Selma Marsh", "notifications"], ["Selma Marsh", "status-page"], ["Tomas Kessler", "admin-console"], ["Tomas Kessler", "status-page"], ["Viktor Hartwell", "invoice-renderer"], ["Viktor Hartwell", "ledger-db"], ["Viktor Hartwell", "reporting"], ["Viktor Hartwell", "webhooks"], ["Yuki Moreau", "reporting"]] UNWIND $pairs AS e MATCH (a:Person {key: e[0]}), (b:System {key: e[1]}) CREATE (a)-[:LINK]->(b) CREATE (b)-[:LINK]->(a);

// [7] [scratch] rows: 0
CYPHER pairs=[["Aiko Rademacher", "Growth"], ["Lars Thorne", "Payments"], ["Luca Ostrander", "Platform"], ["Mateo Sandoval", "Payments"], ["Omar Fenwick", "Growth"], ["Pavel Hollis", "Platform"], ["Priya Farrow", "Support"], ["Sana Petrov", "Payments"], ["Selma Marsh", "Platform"], ["Tomas Kessler", "Support"], ["Viktor Hartwell", "Payments"], ["Yuki Moreau", "Growth"], ["Zara Lowell", "Support"]] UNWIND $pairs AS e MATCH (a:Person {key: e[0]}), (b:Team {key: e[1]}) CREATE (a)-[:LINK]->(b) CREATE (b)-[:LINK]->(a);

// [8] [scratch] rows: 29
CYPHER n=29 seed=1 CALL algo.betweenness({nodeLabels: ['Person', 'Team', 'System'], relationshipTypes: ['LINK'], samplingSize: $n, samplingSeed: $seed}) YIELD node, score RETURN labels(node)[0], node.key, score;

// [9] [scratch] rows: 29
CYPHER n=29 seed=2 CALL algo.betweenness({nodeLabels: ['Person', 'Team', 'System'], relationshipTypes: ['LINK'], samplingSize: $n, samplingSeed: $seed}) YIELD node, score RETURN labels(node)[0], node.key, score;

// [10] [tenant] rows: 62
MATCH (p:Person)-[:MEMBER_OF]->(t:Team) RETURN p.name AS person, t.name AS team, 'MEMBER_OF' AS rel, null AS system, null AS owner UNION MATCH (p:Person)-[r:OWNS|WORKED_ON]->(s:System)<-[:OWNS]-(o:Person)-[:MEMBER_OF]->(t:Team) RETURN p.name AS person, t.name AS team, type(r) AS rel, s.name AS system, o.name AS owner;
